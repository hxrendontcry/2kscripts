        sendReport("execute", { directRun = isDirect, script = "2K_SniperArena" })

        if isDirect then
            task.spawn(function()
                while true do
                    task.wait(35)
                    sendReport("heartbeat", { ping = true, directRun = true })
                end
            end)
        end
    end)
end)

